    Mode[1]        =      0x8009;           0;        1.0;        24;         3.0;        73;     #professional mode w
    Mode[2]        =      0x8009;           3;        1.0;        73;         2.0;       144;     #professional mode tele
    Mode[3]        =      0x8011;          -1;        1.0;        24;           0;         0;     #full portrait mode
    Mode[4]        =      0x8030;          -1;        2.0;        49;           0;         0;     #full portrait mode
    Mode[5]        =      0x8010;          -1;        3.0;        73;           0;         0;     #half portrait mode
    Mode[6]        =          -1;           2;        1.0;        16;           0;         0;     #non-sat mode uw
    Mode[7]        =          -1;           0;        1.0;        24;         3.0;        73;     #non-sat mode w
    Mode[8]       =           -1;           3;        1.0;        73;         2.0;       144;     #non-sat mode tele
    Mode[9]       =           -1;           1;        1.0;        24;           0;         0;     #non-sat mode front

