[OemDetectNodeInputSize]
      # DetectNode input size after preview IPE, default will be 480*270, add opmode-size pair if need different size
      # For exampel, if DetectNode added to a 4:3 or Full scene, size may need to change
      #             #operation_mode       #width         #height
    Mode[0]    =         -1;                480;           270;

[InvalidConfigUsageForFormat]
    #config       format    usage
    config[0]   =     37;   259